# --- PostgreSQL ---
POSTGRES_USER=mangovision
POSTGRES_PASSWORD=changeme_local
POSTGRES_DB=mangovision
POSTGRES_HOST=localhost
POSTGRES_PORT=55432

# DATABASE_URL es lo que consume SQLAlchemy / Alembic
# Nota: 55432 externo -> 5432 interno del contenedor.
# 5432 y 5433 estaban ocupados por procesos del host (wslrelay / postgres en WSL).
DATABASE_URL=postgresql+psycopg://mangovision:changeme_local@localhost:55432/mangovision

# --- MinIO (S3-compatible) ---
MINIO_ROOT_USER=mangovision
MINIO_ROOT_PASSWORD=changeme_local
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=images
MINIO_SECURE=false

# --- JWT ---
JWT_SECRET=cambia-esto-en-produccion-con-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRES_HOURS=8
JWT_RESET_EXPIRES_HOURS=2

# --- App ---
APP_ENV=development
APP_CORS_ORIGINS=http://localhost:5173
